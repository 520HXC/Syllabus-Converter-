APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/syllabus_calendar
AUTH_MODE=supabase
PROCESSING_MODE=eager
EXTRACTION_MODE=local
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://127.0.0.1:5175

SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=syllabi
STORAGE_MODE=local
LOCAL_STORAGE_PATH=.data/uploads

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=200
MAX_OCR_PAGES=50
MAX_EXTRACTED_TEXT_CHARACTERS=500000

# Optional local OCR overrides on Windows
TESSERACT_CMD=
PDF_POPPLER_PATH=
